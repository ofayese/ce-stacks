# Stack: homepage
# All keys are tunables, not secrets.
TIMEZONE=America/New_York

NAS_IP=10.0.1.15
HOMEPAGE_PORT=7575

# Comma-separated list of host:port allowed for direct access.
# Include every hostname/IP used to reach the UI (with port if non-standard).
# Domains proxied by HAProxy/Cloudflare do not need a port suffix.
HOMEPAGE_ALLOWED_HOSTS=10.0.1.15:7575,otsorundscore.olutechsys.com,otsorundscore.olutech.systems

# Grafana widget credentials (services.yaml grafana widget block)
GRAFANA_USERNAME=
GRAFANA_PASSWORD=

# Watchtower widget bearer token (services.yaml watchtower widget block)
# Source: cat ${STACK_ROOT}/grafana-prom/secrets/watchtower_bearer_token.txt
WATCHTOWER_BEARER_TOKEN=

# Zabbix widget credentials (services.yaml zabbix widget block)
# Create a read-only API user in Zabbix: Administration -> Users -> Create user
# Assign role: "Zabbix User" (read-only access, no write permissions needed)
ZABBIX_USERNAME=
ZABBIX_PASSWORD=

# Host bind-mount root (see repo-root `.env.example`; init-nas.sh sets this on the NAS).
STACK_ROOT=/volume2/docker/ce-stacks/stacks
PUID=0
PGID=0
