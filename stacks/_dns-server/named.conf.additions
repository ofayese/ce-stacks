# ─────────────────────────────────────────────────────────────────────────────
# named.conf additions for Synology DNS Server (BIND)
# Apply to: /var/packages/DNSServer/target/etc/named.conf
#
# Instructions:
#   1. Backup first:
#        cp /var/packages/DNSServer/target/etc/named.conf \
#           /var/packages/DNSServer/target/etc/named.conf.bak
#   2. Add the acl block near the top (before the options block).
#   3. Add the four zone blocks at the bottom.
#   4. Validate: named-checkconf /var/packages/DNSServer/target/etc/named.conf
#   5. Reload:   synoservicectl --reload named
#
# SAFETY NOTES:
#   - Do NOT use .local TLD zones — reserved for mDNS/Bonjour (RFC 6762).
#     Overriding it breaks Avahi/Apple device discovery on the LAN.
#     Use .lan instead (see zone "lan" block below).
#   - ACL uses 172.16.0.0/12 (covers 172.16–172.31.x.x) so all Docker bridge
#     networks (grafana-net, flowise-net, n8n-net, zabbix-net, homepage-net,
#     agents-gateway-net, etc.) can reach this DNS server for split-horizon
#     resolution. Do NOT narrow to /16 — that blocks most container subnets.
# ─────────────────────────────────────────────────────────────────────────────

# ── ACL (add near top, before options block) ──────────────────────────────────
acl "trusted" {
    127.0.0.0/8;        # loopback
    10.0.1.0/24;        # NAS LAN subnet
    172.16.0.0/12;      # All Docker bridge networks + VPN/WireGuard peers
                        # (covers 172.16.0.0 – 172.31.255.255)
};

# ── In the options block, add these lines if not already present ──────────────
# (find your existing options { ... }; and add inside it)
#
#   allow-query     { trusted; };
#   allow-recursion { trusted; };
#   recursion yes;

# ── Zone blocks (add at bottom of named.conf) ─────────────────────────────────

zone "olutechsys.com" IN {
    type master;
    file "/var/packages/DNSServer/target/named/olutechsys.com.zone";
    allow-query   { trusted; };
    allow-update  { none; };
};

# .lan zone — safe internal alias (avoids .local mDNS conflict per RFC 6762)
zone "lan" IN {
    type master;
    file "/var/packages/DNSServer/target/named/lan.zone";
    allow-query   { trusted; };
    allow-update  { none; };
};

# Reverse zone for LAN subnet 10.0.1.0/24
zone "1.0.10.in-addr.arpa" IN {
    type master;
    file "/var/packages/DNSServer/target/named/10.0.1.rev.zone";
    allow-query   { trusted; };
    allow-update  { none; };
};

# Reverse zone for VPN/WireGuard peers (172.16.0.x range)
# Create additional /24 reverse zones (1.16.172, 2.16.172 etc.) as peers expand
zone "0.16.172.in-addr.arpa" IN {
    type master;
    file "/var/packages/DNSServer/target/named/172.16.0.rev.zone";
    allow-query   { trusted; };
    allow-update  { none; };
};
