# Stack: searxng (OPTIONAL MariaDB backing)
# Privacy-respecting metasearch engine
# DATABASE: 10.0.1.15:3306 (shared NAS MariaDB - optional for caching)

PUID=0
PGID=0
TZ=America/New_York

# SearXNG web UI
SEARXNG_BASE_URL=http://10.0.1.15:8888
UWSGI_WORKERS=2
UWSGI_THREADS=2

# Optional: MariaDB backing for result caching and search history
# (Leave empty or comment out to use Redis-only caching)
SEARXNG_DB_USER=searxng
SEARXNG_DB_PASSWORD=<set-searxng-db-password>

# Host bind-mount root
STACK_ROOT=/volume2/docker/ce-stacks/stacks
