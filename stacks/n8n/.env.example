# ==============================================================================
# Stack: n8n (Workflow Automation)
# Ports: 5678 (n8n UI + Webhooks)
# HAProxy Backend: n8n-be  -> 10.0.1.15:5678
# Public URL: https://n8n.olutechsys.com (HAProxy + Cloudflare)
# ==============================================================================

# --- NAS + Stack Paths --------------------------------------------------------
NAS_IP=10.0.1.15
STACK_ROOT=/volume2/docker/ce-stacks/stacks

# Synology runs containers as root unless overridden
PUID=0
PGID=0

# Timezone
TZ=America/New_York

# --- n8n Hostnames ------------------------------------------------------------
# Public hostname (NO protocol)
N8N_HOST=n8n.olutechsys.com

# Full external URL (WITH https://)
N8N_WEBHOOK_URL=https://n8n.olutechsys.com

# --- Encryption Key -----------------------------------------------------------
# REQUIRED: Must be set before first start.
# Changing this later will break all existing encrypted credentials.
# Generate with:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Database (MariaDB 10.11 on Synology) ------------------------------------
# DB host is hardcoded to 172.30.2.1 (n8n-net bridge gateway) in compose.yaml.
# Do NOT change to 10.0.1.15 — the Synology firewall blocks Docker subnets
# from reaching port 3306 on the LAN IP. Gateway IP bypasses this.
# Pre-create database + user:
#   mysql -h 127.0.0.1 -P 3306 -u root -p -e "
#     CREATE DATABASE n8n CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     GRANT ALL PRIVILEGES ON n8n.* TO 'n8nuser'@'%' IDENTIFIED BY 'yourpassword';
#     FLUSH PRIVILEGES;
#   "
N8N_DB_USER=n8nuser

# Generate with:
#   openssl rand -base64 24
N8N_DB_PASSWORD=
