# Stack: n8n (workflow automation)
# Ports: 5678 (n8n UI + webhooks)
# HAProxy backend: n8n-be -> 10.0.1.15:5678
# Public URL: https://n8n.olutechsys.com (HAProxy + Cloudflare CNAME)

NAS_IP=10.0.1.15
STACK_ROOT=/volume2/docker/ce-stacks/stacks
PUID=0
PGID=0
TZ=America/New_York

# -- n8n public hostname (no https://) ----------------------------------------
N8N_HOST=n8n.olutechsys.com

# -- n8n webhook / editor base URL (with https://) ----------------------------
N8N_WEBHOOK_URL=https://n8n.olutechsys.com

# -- n8n encryption key -------------------------------------------------------
# Generate: openssl rand -hex 32
# REQUIRED: set before first start; changing this breaks existing credentials.
N8N_ENCRYPTION_KEY=

# -- MariaDB credentials (native Synology MariaDB 10.11 at 10.0.1.15:3306) ----
# Pre-create on NAS:
#   mysql -h 127.0.0.1 -P 3306 -u root -p -e \
#     "CREATE DATABASE n8n CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; \
#      GRANT ALL PRIVILEGES ON n8n.* TO 'n8nuser'@'%' IDENTIFIED BY 'yourpassword'; \
#      FLUSH PRIVILEGES;"
N8N_DB_USER=n8nuser
# Generate: openssl rand -base64 24
N8N_DB_PASSWORD=
