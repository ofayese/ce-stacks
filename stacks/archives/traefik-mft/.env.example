# ── traefik-mft ────────────────────────────────────────────────────
# Cloudflare API token — same scope as acme-sh (Zone.DNS:Edit)
CF_Token=

# Required when Traefik certificatesResolvers.cloudflare is enabled (see compose.yaml).
ACME_EMAIL=

# Traefik dashboard (set true only for debugging — never in production)
TRAEFIK_DASHBOARD=false
# Host publish defaults to 9080 -> container traefik entrypoint :8080.
TRAEFIK_DASHBOARD_PORT=9080
TRAEFIK_LOG_LEVEL=WARN

# Host publish ports — defaults 80/443; see stacks/traefik-ots/.env.example for conflict guidance.
TRAEFIK_HTTP_PUBLISH=80
TRAEFIK_HTTPS_PUBLISH=443

# Timezone
TZ=America/New_York

# ── Standard repo vars ────────────────────────────────────────────
STACK_ROOT=/volume2/docker/ce-stacks/stacks
PUID=0
PGID=0
ACME_CERT_ROOT=/volume2/certs/acme
