# Stack: code-server (MIGRATED to shared NAS MariaDB)
# Code IDE and development environment
# DATABASE: 10.0.1.15:3306 (shared NAS MariaDB)

PUID=0
PGID=0
TZ=America/New_York

# Code-Server access password
CODE_SERVER_PASSWORD=<set-your-password>
SUDO_PASSWORD=<set-your-sudo-password>
DOCKER_USER=coder
PROXY_DOMAIN=10.0.1.15

# Dockhand synology-api-bridge integration
BRIDGE_SHARED_SECRET=<set-from-synology-api-bridge>

# Code-Server workspace volume bindings
CODE_SERVER_HOST_DOCKER_BIND=/var/run/docker.sock
CODE_SERVER_HOST_HOME_BIND=/root

# PhpMyAdmin for shared MariaDB access
PMA_CONTROLUSER=pma
PMA_CONTROLPASS=<set-pma-password>
PMA_BLOWFISH_SECRET=<set-blowfish-secret>
PMA_ABSOLUTE_URI=http://10.0.1.15:8379

# MySQL application password (for the code-server MySQL user)
MYSQL_APP_PASSWORD=

# Host bind-mount root
STACK_ROOT=/volume2/docker/ce-stacks/stacks
