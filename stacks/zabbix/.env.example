# Copy to .env and set strong secrets. Never commit .env.
STACK_ROOT=/ce-stacks/stacks
PUID=0
PGID=0
TZ=America/New_York

POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
# REQUIRED — generate with: openssl rand -hex 32
# Passed as a plain env var (Zabbix images do not support POSTGRES_PASSWORD_FILE).
# Appears in `docker inspect` output; mitigate by restricting Docker socket access.
POSTGRES_PASSWORD=

ZABBIX_WEB_PORT=8532
ZABBIX_SERVER_PUBLISH=10051

# Optional: when you enable the commented zabbix-agent2 service.
# ZBX_AGENT_HOSTNAME=zabbix-agent-docker
