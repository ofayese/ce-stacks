# Stack: zabbix (MIGRATED to shared NAS MariaDB)
# Zabbix monitoring platform - server, web UI, and agent
# DATABASE: 10.0.1.15:3306 (shared NAS MariaDB)

PUID=0
PGID=0
TZ=America/New_York

# Zabbix ports
ZABBIX_SERVER_PORT=10051
ZABBIX_WEB_PORT=8532

# MariaDB connection (shared NAS instance at 10.0.1.15:3306)
MYSQL_ROOT_PASSWORD=<set-via-nas-mariadb>
MYSQL_DATABASE=zabbix
MYSQL_USER=zabbix
MYSQL_PASSWORD=<set-to-zabbix-db-password>

# Zabbix Agent hostname (for self-monitoring)
# Must match the Host object name created in the Zabbix frontend exactly.
ZBX_HOSTNAME=zabbixagt2

# Host bind-mount root
STACK_ROOT=/volume2/docker/ce-stacks/stacks
