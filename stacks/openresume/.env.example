# Stack: openresume
# All keys are tunables, no secrets (resume data is client-side localStorage).
TZ=America/New_York

# Override if HAProxy frontend hostname changes:
NEXT_PUBLIC_BASE_URL=https://resume.olutechsys.com
# STACK_ROOT: not referenced in compose.yaml (no bind-mount volumes in this stack).
PUID=0
PGID=0
