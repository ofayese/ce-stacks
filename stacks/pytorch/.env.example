# Stack: pytorch
# PyTorch + JupyterLab on aarch64 (DS723+)
# UI: https://jupyter.olutechsys.com (via HAProxy)
# Direct: http://10.0.1.15:8897
#
# IMPORTANT: First start installs PyTorch via pip (~5-10 min on aarch64).
# Subsequent starts use /root/.cache and are fast.

NAS_IP=10.0.1.15

# REQUIRED: JupyterLab authentication token
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JUPYTER_TOKEN=

# Host bind-mount root
STACK_ROOT=/volume2/docker/ce-stacks/stacks
