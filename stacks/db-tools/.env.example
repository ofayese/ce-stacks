# Stack: db-tools (Adminer)
# Stateless GUI tool -- no database data stored here.
# Adminer covers MariaDB, PostgreSQL, and SQLite in a single container.
# Databases are managed by Synology native packages (DSM Package Center):
#   MariaDB    -> 10.0.1.15:3306
#   PostgreSQL -> 10.0.1.15:5432
#
# phpMyAdmin has been removed from this stack -- Adminer covers both.
# CodeServerPMA (stacks/code-server, port 8379) handles the code-server MySQL sidecar.
#
# HAProxy backend: adminer-be -> 10.0.1.15:8895

TZ=America/New_York
NAS_IP=10.0.1.15
ADMINER_PORT=8895
PUID=0
PGID=0

# Adminer: default server shown in login form (can be changed at login time)
ADMINER_DEFAULT_SERVER=10.0.1.15
