# Stack: db-tools (Adminer + PhpMyAdmin)
# Stateless GUI tools — no database data stored here.
# Databases are managed by Synology native packages (DSM Package Center):
#   MariaDB → port 3306 on 10.0.1.15
#   PostgreSQL → port 5432 on 10.0.1.15

# HAProxy backends:
#   adminer-be    → 10.0.1.15:8895
#   phpmyadmin-be → 10.0.1.15:8378

TZ=America/New_York
PUID=0
PGID=0

# Adminer: default server shown in login form (can be changed at login time)
ADMINER_DEFAULT_SERVER=10.0.1.15

# PhpMyAdmin: MariaDB host and port (must be NAS LAN IP, not localhost)
PMA_HOST=10.0.1.15
PMA_PORT=3306

# Host bind-mount root (set by init-nas.sh; required by repo conventions)
STACK_ROOT=/volume2/docker/ce-stacks/stacks
