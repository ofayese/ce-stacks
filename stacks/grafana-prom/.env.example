# Stack: grafana-prom
# Copy to .env (never commit .env).

TIMEZONE=America/New_York
NAS_IP=10.0.1.15

# Grafana web UI port
GRAFANA_PORT=3340
PROMETHEUS_PORT=9090

# MariaDB backing — TCP via NAS LAN IP (socket auth fails on Synology DSM).
# MariaDB binds to 10.0.1.15:3306. otsadmin has db-specific privileges on otsgrafanadb.
# Verify grant in phpMyAdmin or:
#   mysql -h 127.0.0.1 -P 3306 -u root -p -e "SHOW GRANTS FOR 'otsadmin'@'%';"
MYSQL_HOST=10.0.1.15:3306
GRAFANA_DB_NAME=otsgrafanadb
GRAFANA_DB_USER=otsadmin
# REQUIRED -- set to otsadmin's MariaDB password
GRAFANA_DB_PASSWORD=

# SNMP monitoring (optional, for NAS SNMP targets)
SNMP_USERNAME=snmpadmin
SNMP_AUTH_PASSWORD=
SNMP_PRIV_PASSWORD=

# Alertmanager Discord notifications use a secret file
# Create: echo -n '<webhook-url>' > secrets/discord_webhook_url.txt

# Watchtower Prometheus scrape uses bearer_token_file
# Create: echo -n '<token>' > secrets/watchtower_bearer_token.txt

# WireGuard tunnel monitoring (interface hardcoded to wg0 in compose.yaml)
# Prerequisite: run `wg-quick up wg0` before deploying

# Host bind-mount root (set on NAS via init-nas.sh)
STACK_ROOT=/volume2/docker/ce-stacks/stacks
PUID=0
PGID=0
