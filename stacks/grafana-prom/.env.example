# Stack: grafana-prom
# Copy to .env (never commit .env).
# SYNO_* avoids bash reserved UID/GID in tooling that sources env files.

SYNO_UID=0
SYNO_GID=0
TIMEZONE=America/New_York

# Used in prom.yml for SNMP targets - align with your NAS management IP.
NAS_IP=10.0.1.15

SNMP_USERNAME=snmpadmin
SNMP_AUTH_PASSWORD=<the auth password you just set>
SNMP_PRIV_PASSWORD=<the priv password you just set>

GRAFANA_PORT=3340
PROMETHEUS_PORT=9090

# Alertmanager - Discord notifications (GAP-04)
# Also update alertmanager.yml: replace REPLACE_WITH_DISCORD_WEBHOOK_URL with this value.
# Get it from: Discord server → Settings → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Watchtower Prometheus scrape uses bearer_token_file (not this .env):
# create secrets/watchtower_bearer_token.txt - see secrets/README.md and watchtower/compose.yaml.

# Host bind-mount root (see repo-root `.env.example`; init-nas.sh sets this on the NAS).
STACK_ROOT=/ce-stacks/stacks
PUID=0
PGID=0
