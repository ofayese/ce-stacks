# Stack: grafana-prom
# Copy to .env (never commit .env).

TIMEZONE=America/New_York

# Used in prom.yml for SNMP targets - align with your NAS management IP.
NAS_IP=10.0.1.15

SNMP_USERNAME=snmpadmin
SNMP_AUTH_PASSWORD=<the auth password you just set>
SNMP_PRIV_PASSWORD=<the priv password you just set>

GRAFANA_PORT=3340
PROMETHEUS_PORT=9090

# Alertmanager Discord notifications use a secret file, not this .env.
# See secrets/README.md -> discord_webhook_url.txt

# Watchtower Prometheus scrape uses bearer_token_file (not this .env):
# create secrets/watchtower_bearer_token.txt - see secrets/README.md and watchtower/compose.yaml.

# WireGuard tunnel monitoring (Phase 4)
# Interface is hardcoded to wg0 in compose.yaml command: block (env var not reliably picked
# up by clap v3). If you rename the interface, edit compose.yaml wireguard-exporter command:.
# Prerequisite: run `wg-quick up wg0` (or DSM Task Scheduler boot script) before deploying.

# Host bind-mount root (see repo-root `.env.example`; init-nas.sh sets this on the NAS).
STACK_ROOT=/volume2/docker/ce-stacks/stacks
PUID=0
PGID=0
