# Stack: psu-ots - PowerShell Universal (NAS automation / NOC dashboard)
# Copy to .env (gitignored) on the NAS before first deploy.
# STACK_ROOT is normally injected by init-nas.sh into the repo-root .env;
# override here only if this stack is deployed standalone.
# STACK_ROOT=/volume2/docker/ce-stacks/stacks

TZ=America/New_York
PUID=0
PGID=0

# ── Repo & stack paths ────────────────────────────────────────────────
# Monorepo root (parent of stacks/) - mounted read-only at /nas-repo.
# Change to :rw in compose volumes if GitOps webhook pull is enabled.
NAS_REPO_ROOT=/volume2/docker/ce-stacks

# Passed into container as PSU_STACK_ROOT (same as host STACK_ROOT).
PSU_STACK_ROOT=/volume2/docker/ce-stacks/stacks

# Let's Encrypt / acme.sh certificate root - mounted read-only at /certs/acme.
ACME_CERT_ROOT=/volume2/certs/acme

# ── Stack manager API ─────────────────────────────────────────────────
# Generic stack-agnostic names — point at whichever stack manager is active.
# Currently Dockhand on port 3866. Change URL here if the stack manager changes.
STACK_MANAGER_URL=http://10.0.1.15:3866
STACK_MANAGER_USERNAME=
STACK_MANAGER_PASSWORD=

# ── PSU authentication ────────────────────────────────────────────────
# Webhook POST /api/v1/nas/pull - set in PSU Admin → Security → App Tokens.
NAS_PULL_APP_TOKEN=

# PSU REST (/api/v1/*) Bearer token - set before enabling API endpoints.
PSU_AUTH_TOKEN=

# ── Dangerous operations (default: all off) ───────────────────────────
PSU_ALLOW_STACK_RESTART=0

# Auto-remediation: restart unhealthy stacks, docker prune, disk/CPU triage.
PSU_REMEDIATION_ENABLED=0
PSU_REMEDIATION_DOCKER_PRUNE=0
PSU_REMEDIATION_DISK_THRESHOLD_PCT=90
PSU_REMEDIATION_LOADAVG1_CRITICAL=8
PSU_REMEDIATION_MEM_AVAILABLE_RATIO_MIN=0.08
PSU_REMEDIATION_DOCKER_CPU_PCT=90
PSU_REMEDIATION_CPU_TRIAGE=0

# ── Safe Mode ─────────────────────────────────────────────────────────
# Triggered on degraded mdstat / btrfs uncorrectable errors.
PSU_SAFE_MODE_ENABLED=0
# Comma-separated stack folder names to stop under NAS_HOST_STACKS_ROOT.
PSU_SAFE_MODE_STOP_STACKS=
# After Safe Mode, queue backup-snapshot job (1=yes, 0=skip).
PSU_SAFE_MODE_QUEUE_BACKUP=1
PSU_SAFE_MODE_WEBHOOK_URL=
PSU_SAFE_MODE_DISCORD_WEBHOOK=
# POST /api/v1/webhooks/nas-alert - if set, Synology sends this as Bearer token.
PSU_NAS_ALERT_WEBHOOK_TOKEN=

# ── Host SSH (optional - see NAS_HOST_SSH_SETUP.md) ──────────────────
# Required for docker compose over SSH and CPU/memory triage remediation.
NAS_HOST_IP=
NAS_SSH_USER=
# Path inside the container (host key lives at stacks/psu-ots/keys/; mounted :ro).
SSH_KEY_PATH=/ssh-keys/psu_remediation_key
# Host absolute path to stacks/ for docker compose over SSH.
NAS_HOST_STACKS_ROOT=/volume2/docker/ce-stacks/stacks
# Writable known_hosts path inside the container.
NAS_SSH_KNOWN_HOSTS_FILE=/data/reports/_psu_ssh_known_hosts

# ── GitOps ───────────────────────────────────────────────────────────
# Requires compose volume /nas-repo mounted :rw, git identity, and NAS credentials.
# Never commit secrets - store in .env only.
PSU_GITOPS_ENABLED=0
PSU_GITOPS_AUTO_COMMIT=0
PSU_GITOPS_AUTO_PUSH=0
PSU_GITOPS_COMMIT_MESSAGE=chore(gitops): auto-sync drift configurations
PSU_GIT_USER_NAME=
PSU_GIT_USER_EMAIL=

# ── Reporting ─────────────────────────────────────────────────────────
# JSON job output directory inside the container (binds to psu-ots/data/reports on host).
PSU_REPORTS_ROOT=/data/reports

# ── PSU Gallery ───────────────────────────────────────────────────────
# PSU_GALLERY_OPTIONAL=1  - allow partial module import (staging / test only).
# PSU_GALLERY_INSTALL=1   - download modules from PSGallery on container start (needs outbound HTTPS).
# PSU_GALLERY_INSTALL_STRICT=0 - continue install even if some packages fail.
# PSU_GALLERY_INCLUDE_WINDOWS=1 - include Windows-only gallery names (non-Linux hosts only).
PSU_GALLERY_OPTIONAL=0
PSU_GALLERY_INSTALL=0
PSU_GALLERY_INSTALL_STRICT=1
PSU_GALLERY_INCLUDE_WINDOWS=0
