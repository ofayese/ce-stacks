# Stack: ollama (otsai-server + ollama-model-init + otsai-webui)
# Hardware: DS723+, AMD Ryzen R1600 (2 cores), 32 GB RAM, CPU-only, no GPU.
# See docs/tasks/OLLAMA_MODEL_SELECTION_DS723.md for full model guide.

# TZ: hardcoded in compose.yaml (America/New_York) — not an interpolated variable.
BRIDGE_SHARED_SECRET=
# -- CPU tuning - keep parallel=1 for single-core inference --------------------
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# Model idle timeout before unloading from RAM.
# 30m: good balance for interactive sessions (CPU reload takes 15-60s).
# -1:  keep loaded indefinitely. 5m: conserve RAM between infrequent sessions.
OLLAMA_KEEP_ALIVE=30m

# -- Model pull override -------------------------------------------------------
# The default model list is hardcoded in scripts/entrypoint.sh.
# To pull a different set without editing entrypoint.sh, set MODELS here:
# MODELS=phi4:mini,nomic-embed-text
# OLLAMA_TIER{1,2,3}_MODELS removed: entrypoint.sh does not read tier variables.

# -- Open-WebUI default model dropdown

# Comma-separated. Does NOT auto-pull - ollama-model-init handles that.
DEFAULT_MODELS=stablelm2:3b,stablelm2:7b,qwen2.5-coder:7b,nomic-embed-text

# -- Open-WebUI URL (for HAProxy routing)
WEBUI_URL=https://10.0.1.15:8893

# -- Host bind-mount root (init-nas.sh sets this on the NAS) -------------------
STACK_ROOT=/volume2/docker/ce-stacks/stacks
PUID=0
PGID=0
