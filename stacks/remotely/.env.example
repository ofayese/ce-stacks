# Stack: remotely (OPTIONAL MariaDB backing)
# Remote support platform: remote control and IT support tooling
# DATABASE: SQLite (default) or 10.0.1.15:3306 (shared NAS MariaDB for HA)

PUID=0
PGID=0
TZ=America/New_York

# Remotely web UI and known proxy
REMOTELY_KNOWN_PROXY=10.0.1.15
REMOTELY_SERVER_URL=https://remotely.olutechsys.com

# Database provider: SQLite (default) or MySQL (for HA)
# SQLite: Remotely_ApplicationOptions__DbProvider=SQLite
# MySQL: Remotely_ApplicationOptions__DbProvider=MySQL
# Keep SQLite for single-server setups; use MySQL for clustering
REMOTELY_DB_PROVIDER=SQLite

# Connection string for MySQL (if REMOTELY_DB_PROVIDER=MySQL)
# Format: Server=HOST;Port=PORT;Database=DB;User=USER;Password=PASS;
REMOTELY_CONNECTION_STRING=

# Host bind-mount root
STACK_ROOT=/volume2/docker/ce-stacks/stacks
