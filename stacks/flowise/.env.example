# ==============================================================================
# Stack: Flowise (Visual LangChain Workflow Builder)
# Ports: 8459 (Flowise UI via HAProxy), internal service port 3000
# HAProxy Backend: flowise-be -> 10.0.1.15:8459
# Public URL: https://flowise.olutechsys.com (HAProxy + Cloudflare)
# Ollama (local LLMs inside flows): http://10.0.1.15:11434
# ==============================================================================

# --- NAS + Stack Paths --------------------------------------------------------
NAS_IP=10.0.1.15
STACK_ROOT=/volume2/docker/ce-stacks/stacks
TZ=America/New_York

# --- Flowise Credentials ------------------------------------------------------
FLOWISE_USERNAME=admin
# Use a strong password; leave blank in example
FLOWISE_PASSWORD=

# --- Public URL (WITH https://) ----------------------------------------------
FLOWISE_APP_URL=https://flowise.olutechsys.com

# --- JWT Secret ---------------------------------------------------------------
# REQUIRED: Must be set before first start.
# Generate with:
#   openssl rand -hex 32
FLOWISE_JWT_SECRET=

# --- Database (MariaDB 10.11 on Synology) ------------------------------------
# Pre-create database + user:
#   mysql -h 127.0.0.1 -P 3306 -u root -p -e "
#     CREATE DATABASE flowise CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     GRANT ALL PRIVILEGES ON flowise.* TO 'flowiseuser'@'%' IDENTIFIED BY 'yourpassword';
#     FLUSH PRIVILEGES;
#   "
FLOWISE_DB_USER=flowiseuser

# Generate with:
#   openssl rand -base64 24
FLOWISE_DB_PASSWORD=

# --- SMTP (Optional — leave blank to disable email features) ------------------
FLOWISE_SMTP_HOST=
FLOWISE_SMTP_PORT=587
FLOWISE_SMTP_USER=
FLOWISE_SMTP_PASSWORD=
FLOWISE_SMTP_SECURE=STARTTLS
