# Stack: flowise (visual LangChain workflow builder)
# Ports: 8459 (Flowise UI, internal 3000)
# HAProxy backend: flowise-be -> 10.0.1.15:8459
# Public URL: https://flowise.olutechsys.com (HAProxy + Cloudflare CNAME)
# Ollama connection (inside flows): http://10.0.1.15:11434

NAS_IP=10.0.1.15
STACK_ROOT=/volume2/docker/ce-stacks/stacks
TZ=America/New_York

# -- Flowise credentials ------------------------------------------------------
FLOWISE_USERNAME=admin
# Use a strong password
FLOWISE_PASSWORD=

# -- Flowise public URL (with https://) ---------------------------------------
FLOWISE_APP_URL=https://flowise.olutechsys.com

# -- JWT secret ---------------------------------------------------------------
# Generate: openssl rand -hex 32
FLOWISE_JWT_SECRET=

# -- MariaDB credentials (native Synology MariaDB 10.11 at 10.0.1.15:3306) ----
# Pre-create on NAS:
#   mysql -h 127.0.0.1 -P 3306 -u root -p -e \
#     "CREATE DATABASE flowise CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; \
#      GRANT ALL PRIVILEGES ON flowise.* TO 'flowiseuser'@'%' IDENTIFIED BY 'yourpassword'; \
#      FLUSH PRIVILEGES;"
FLOWISE_DB_USER=flowiseuser
# Generate: openssl rand -base64 24
FLOWISE_DB_PASSWORD=

# -- SMTP (optional — leave blank to skip email features) ---------------------
FLOWISE_SMTP_HOST=
FLOWISE_SMTP_PORT=587
FLOWISE_SMTP_USER=
FLOWISE_SMTP_PASSWORD=
FLOWISE_SMTP_SECURE=STARTTLS
