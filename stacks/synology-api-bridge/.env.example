# Stack: synology-api-bridge — internal DSM HTTP shim (FastAPI)
# Copy to .env (gitignored). Never commit secrets.

# Required — callers must send header X-Bridge-Secret with this exact value.
# Generate: openssl rand -hex 32
BRIDGE_SHARED_SECRET=

# Required for DSM-backed routes (ping, syno-api, etc.)
# No trailing slash. Example: https://10.0.1.15:5001
DSM_BASE_URL=

# Optional — outbound timeout for DSM HTTP calls (seconds)
DSM_HTTP_TIMEOUT_SECONDS=5

# Host bind-mount root (see repo-root `.env.example`; init-nas.sh sets this on the NAS).
STACK_ROOT=/volume2/docker/ce-stacks/stacks
NAS_IP=10.0.1.15
PUID=0
PGID=0
