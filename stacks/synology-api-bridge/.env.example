# Stack: synology-api-bridge - internal DSM HTTP shim (FastAPI)
# Copy to .env (gitignored). Never commit secrets.

# Required - callers must send header X-Bridge-Secret with this exact value To generate a strong, secure 64-character hexadecimal string for your BRIDGE_SHARED_SECRET, you can use the following OpenSSL command:
#openssl rand -hex 32
BRIDGE_SHARED_SECRET=

# Required for DSM-backed routes (ping, syno-api, etc.): DSM web origin, no trailing slash, e.g. https://10.0.1.15:5001
DSM_BASE_URL=

# Optional - outbound timeout for DSM HTTP calls (seconds)
DSM_HTTP_TIMEOUT_SECONDS=5

# Optional - outbound timeout for DSM HTTP calls (seconds)
DSM_HTTP_TIMEOUT_SECONDS=5
