# Stack: influxdb
# Time-series database for ntopng network traffic metrics.
# Copy to .env (never commit .env -- it contains passwords).
#
# InfluxDB 1.8.10 creates users and the default database on first start only
# (when /var/lib/influxdb is empty). If you change passwords here after first
# start, update them via the influx CLI -- env vars are ignored after init.

TZ=America/New_York
PUID=0
PGID=0

# Admin credentials -- management only; do not use in ntopng or Grafana
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=<strong-admin-password>

# Default database name -- must match ntopng Settings -> Timeseries -> InfluxDB -> Database
INFLUXDB_DATABASE=ntopng

# Write-only user for ntopng -- use in ntopng Settings -> Timeseries -> InfluxDB -> User/Password
INFLUXDB_NTOPNG_PASSWORD=<ntopng-write-password>

# Read-only user for Grafana -- keep in sync with grafana-prom/.env INFLUXDB_GRAFANA_PASSWORD
INFLUXDB_GRAFANA_PASSWORD=<grafana-read-password>

# Host bind-mount root (set by init-nas.sh; required by repo conventions)
STACK_ROOT=/volume2/docker/ce-stacks/stacks
