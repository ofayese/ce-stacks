# =============================================================================
# ce-stacks -- root .gitignore
# Covers: macOS/Synology sidecars, secrets, runtime data, Python artefacts
# =============================================================================

# ---------------------------------------------------------------------------
# macOS & Synology filesystem garbage
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
@eaDir/
@tmp/
# Synology SMB temp files (Finder-over-SMB creates these)
.smbdelete*
# Synology package-manager junk
.SynologyWorkingDirectory

# ---------------------------------------------------------------------------
# Secret material -- NEVER commit
# ---------------------------------------------------------------------------
# Private keys (all forms)
*.key
*.pem
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.*
id_dsa
id_dsa.*
account.key
cert.key

# Secret text files in per-stack secrets/ directories (passwords, tokens, etc.)
# These are consumed by Docker secrets at runtime; must never be committed.
# NOTE: stacks/databases/secrets/*.txt and stacks/grafana-prom/secrets/*.txt
# contain intentional CI dummy values and are already tracked -- use
# `git rm --cached` to stop tracking them if you replace with real credentials.
stacks/acme-sh/secrets/*.txt
stacks/code-server/secrets/*.txt
stacks/grafana-prom/secrets/*.txt

# Dockhand stacks paths (moved from root stacks/)
dockhand/stacks/acme-sh/secrets/*.txt
dockhand/stacks/code-server/secrets/*.txt
dockhand/stacks/grafana-prom/secrets/*.txt
dockhand/stacks/code-server/config/.ssh/
dockhand/stacks/*/secrets/*.txt

# ---------------------------------------------------------------------------
# Runtime .env files -- keep .env.example, never commit .env
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
# Allow the templates
!.env.example

# ---------------------------------------------------------------------------
# Stack runtime data directories -- contain secrets / large blobs
# ---------------------------------------------------------------------------
# acme.sh certificates and account keys
stacks/acme-sh/data/

# Ollama models + SSH identity
stacks/ollama/data/

# GitHub Desktop SSL material
stacks/github-desktop/config/ssl/

# Generic runtime data patterns (per-stack data dirs that hold runtime state)
# Specific stacks that generate runtime secrets inside data/
stacks/databases/data/
stacks/code-server/data/
stacks/zabbix/data/
stacks/grafana-prom/data/

# ---------------------------------------------------------------------------
# Docker / Compose artefacts
# ---------------------------------------------------------------------------
# Compose override files (local dev tweaks)
docker-compose.override.yml
compose.override.yaml

# ---------------------------------------------------------------------------
# Python artefacts (synology-api-bridge)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Node / JS (if any tooling added later)
# ---------------------------------------------------------------------------
node_modules/
.npm/
*.tgz

# ---------------------------------------------------------------------------
# Editor & IDE
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.orig

# ---------------------------------------------------------------------------
# Logs & temp
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak
tmp/
temp/

# ---------------------------------------------------------------------------
# Git artefacts (Synology NAS git repo integrity)
# ---------------------------------------------------------------------------
# Synology EA sidecar bundles inside .git/ -- handled by git hooks, not here
# See scripts for EA cleanup tooling
stacks/influxdb/data/
ces-env/

# =============================================================================
# Root volume overrides for NAS-level Git root
# =============================================================================
# Ignore other root volume directories
/archive/
/dumps/
/garage/
/lfs/
/mbprodocker/
/projects/
/.minio.sys/

# Ignore Dockhand active runtime directories & secrets
/dockhand/db/
/dockhand/git-repos/
/dockhand/snapshots/
/dockhand/scanner-cache/
/dockhand/tmp/
/dockhand/.encryption_key
/dockhand/.env
/dockhand/icons/

# Separate project (has its own repo)
/github-code-review-skill/


# Code-server runtime data (generated by running container)
dockhand/stacks/code-server/config/.config/
dockhand/stacks/code-server/config/.local/
dockhand/stacks/code-server/config/.cache/
dockhand/stacks/code-server/config/extensions/
dockhand/stacks/code-server/config/.bashrc
dockhand/stacks/code-server/data/
dockhand/stacks/code-server/secrets/

# Code-server ALL runtime data (container bind mounts)
dockhand/stacks/code-server/config/data/
dockhand/stacks/code-server/config/.config/
dockhand/stacks/code-server/config/.local/
dockhand/stacks/code-server/config/.cache/
dockhand/stacks/code-server/config/extensions/
dockhand/stacks/code-server/config/.vscode-remote/
dockhand/stacks/code-server/config/.npm/
dockhand/stacks/code-server/config/.bashrc
dockhand/stacks/code-server/config/.profile
dockhand/stacks/code-server/config/.zshrc
