<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Unique label — must match the filename -->
  <key>Label</key>
  <string>com.laolu.docker.qdrant</string>

  <!-- Run the script at login -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Do NOT restart automatically — the container has its own restart policy -->
  <key>KeepAlive</key>
  <false/>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/laolufayese/.docker/scripts/start-qdrant.sh</string>
  </array>

  <!-- Logs — check these if startup fails -->
  <key>StandardOutPath</key>
  <string>/Users/laolufayese/.docker/logs/qdrant-startup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/laolufayese/.docker/logs/qdrant-startup-error.log</string>

  <!-- Give the desktop session time to settle before running -->
  <key>StartInterval</key>
  <integer>0</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    <key>HOME</key>
    <string>/Users/laolufayese</string>
  </dict>
</dict>
</plist>
