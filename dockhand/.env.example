# Dockhand Environment Variables
# =============================================================================
# This .env file is optional for Dockhand stack deployment.
# Most configuration is handled via the Dockhand web UI (Settings menu).
#
# If deploying via docker compose (manual), populate these variables:
# =============================================================================

# Synology DSM standard user/group IDs
# Keep at 0 (root) for bind-mount compatibility with DSM
PUID=0
PGID=0

# Timezone
TZ=America/New_York

# Stack root path (used by RC script, not typically needed in compose)
# STACK_ROOT=/volume2/docker/ce-stacks

# Dockhand data directory path
# DOCKHAND_DATA=/volume2/docker/dockhand

# Optional: Pin Dockhand image to specific version (instead of 'latest')
# DOCKHAND_IMAGE=fnsys/dockhand:0.2.0

# Optional: Database backend (Dockhand supports SQLite or PostgreSQL)
# Default: SQLite at /app/data/db/dockhand.db
# DATABASE_URL=sqlite:/app/data/db/dockhand.db
# DATABASE_URL=postgresql://user:password@postgres:5432/dockhand

# Optional: Custom hostname for license validation (detected automatically)
# DOCKHAND_HOSTNAME=ds723

# Optional: Custom log level (debug, info, warn, error)
# LOG_LEVEL=info

# Synology-specific: Skip expensive disk usage collection (improves UI performance)
# This is set in the RC script and compose.yaml; no need to change here
SKIP_DF_COLLECTION=true
