# Stack: dozzle
# Auth users live in users.yml (mounted into /data/users.yml inside the container).
# Generate users with:
#   docker run --rm amir20/dozzle:latest generate <username> --password <pass>
# and append output to dozzle/users.yml.

# TZ and DOZZLE_AUTH_PROVIDER are hardcoded in compose.yaml — not interpolated variables.
# To change either, edit compose.yaml directly.

# Host bind-mount root (see repo-root `.env.example`; init-nas.sh sets this on the NAS).
STACK_ROOT=/volume2/docker/ce-stacks/stacks
PUID=0
PGID=0
