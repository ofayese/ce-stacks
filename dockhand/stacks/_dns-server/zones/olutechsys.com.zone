; Zone: olutechsys.com
; Type: Forward / Master
; Managed via: Synology DNS Server UI (http://10.0.1.15:5010)
; Serial: 2026052201 (date format)
;
; This file is a REFERENCE COPY — actual zone lives on the NAS at:
;   /var/packages/DNSServer/target/named/etc/zone/master/olutechsys.com
;   (no file extension — that is the DSM convention)
;
; Zone declaration is at:
;   /var/packages/DNSServer/target/named/etc/zone/data/olutechsys.com
;
; After editing the live file, bump the serial and reload:
;   sudo kill -HUP $(pgrep named)
;
; IMPORTANT: This zone must appear in BOTH the "internal" and "wireguard"
; views in zone.load.conf. The "external" view has match-clients {none;} and
; serves nobody — do not rely on it for LAN or Docker resolution.

$TTL 300
$ORIGIN olutechsys.com.

@   IN  SOA  otsorundscore.olutechsys.com. admin.olutechsys.com. (
              2026052201  ; serial
              3600        ; refresh
              900         ; retry
              604800      ; expire
              300 )       ; negative TTL

; Nameserver
@               IN  NS   otsorundscore.olutechsys.com.

; Apex → NAS/HAProxy (all LAN clients hit 10.0.1.15 for the bare domain)
@               IN  A    10.0.1.15

; NAS host
otsorundscore   IN  A    10.0.1.15

; Wildcard — catches every subdomain (grafana, search, dozzle, etc.)
; and routes them all to HAProxy on 10.0.1.15 automatically
*               IN  A    10.0.1.15

; misfitsds — explicit record required (different IP, wildcard would be wrong)
misfitsds       IN  A    10.0.1.24
