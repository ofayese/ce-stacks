# Stack: acme-sh
# Copy to .env on each machine (git never ships .env). If cp fails: sudo cp .env.example .env && sudo chown "$(id -un)":"$(id -gn)" .env
# Required (secrets):
CF_Token=                              # Cloudflare API token with Zone.DNS:Edit on relevant zones
# DISCORD_WEBHOOK_URL: transitioned to Docker secret file.
# Populate: echo -n 'https://discord.com/api/webhooks/...' > secrets/discord_webhook_url.txt

# Optional (tunables - usually not changed):
PUID=0
PGID=0

# Host bind-mount root (see repo-root `.env.example`; init-nas.sh sets this on the NAS).
STACK_ROOT=/volume2/docker/ce-stacks/stacks
# Host path for ACME cert output (default Synology layout).
ACME_CERT_ROOT=/volume2/certs/acme

# Reference only - not read by compose.yaml. Lab LAN defaults from stacks/acme-sh/SETUP.md:
# NAS_IP_OTS=10.0.1.15    # otsorundscore (OTS) - HAProxy/Traefik backends, Docker narrow TCP examples
# NAS_IP_MFT=10.0.1.24    # misfitsds (MFT)
