# host.map.static — native Synology packages and bare-metal services
# Managed manually. Docker service entries are generated from haproxy.* compose labels.
# Run: bash /volume2/docker/ce-stacks/scripts/generate-haproxy.sh
#
# Format: <hostname><TAB><backend-name>

# ---------------------------------------------------------------------------
# DSM dashboard — default fallback for all unmatched hostnames
# ---------------------------------------------------------------------------
otsorundscore.olutechsys.com	otsorundscore-be
otsorundscore.olutech.systems	otsorundscore-be

# ---------------------------------------------------------------------------
# HAProxy management UI — proxied via HTTPS frontend on port 8280
# haproxyhttps-be terminates TLS at 8280 and forwards plain HTTP to 8281.
# Direct LAN access (http://10.0.1.15:8281) hits the listen stats block
# directly — no host.map entry needed for that path.
# ---------------------------------------------------------------------------
haproxy.olutechsys.com	haproxyhttps-be
haproxy.olutech.systems	haproxyhttps-be

# Dockhand (bare-metal RC script)
dockhand.olutechsys.com	dockhand-be
dockhand.olutech.systems	dockhand-be

# SaltGUI (SynoCommunity salt-master)
saltgui.olutechsys.com	saltgui-be
saltgui.olutech.systems	saltgui-be

# ntopng (native NAS package)
ntopng.olutechsys.com	ntopng-be
ntopng.olutech.systems	ntopng-be

# OTS native Synology services
otscal.olutechsys.com	otscal-be
otscal.olutech.systems	otscal-be
otscnt.olutechsys.com	otscnt-be
otscnt.olutech.systems	otscnt-be
otsfst.olutechsys.com	otsfst-be
otsfst.olutech.systems	otsfst-be
otsnt.olutechsys.com	otsnt-be
otsnt.olutech.systems	otsnt-be
sso.olutechsys.com	sso-be
sso.olutech.systems	sso-be
otspht.olutechsys.com	otspht-be
otspht.olutech.systems	otspht-be
otsvmm.olutechsys.com	otsvmm-be
otsvmm.olutech.systems	otsvmm-be
